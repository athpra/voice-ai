# Copy to .env and fill in for local development.
# In CML, these are set as Application environment variables instead (see
# .project-metadata.yaml and the README's "Deploying to CML" section).

PORT=8090
PUBLIC_BASE_URL=
DEMO_PHONE_NUMBER=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true

STT_PROVIDER=deepgram
TTS_PROVIDER=cartesia

DEEPGRAM_API_KEY=

CARTESIA_API_KEY=
CARTESIA_TTS_VOICE_ID=e07c00bc-4134-4eae-9ea4-1a55fb45746b
CARTESIA_TTS_MODEL_ID=sonic-3
CARTESIA_STT_MODEL=ink-whisper

CAII_BASE_URL=
CAII_API_KEY=
CAII_MODEL_NAME=meta/llama-3.1-8b-instruct
# Reasoning models (e.g. NVIDIA Nemotron) think before answering -- unwanted
# latency for a phone call. Set the directive that disables it; it's folded
# into the front of the system prompt. Try "detailed thinking off"
# (Llama-Nemotron) or "/no_think" (Nemotron Nano v2). Leave blank for
# non-reasoning models like llama-3.1-8b.
CAII_THINKING_DIRECTIVE=
# Max tokens per reply. Reasoning models need enough room to finish thinking
# before the answer, so this is generous. Drop it to ~256 for a plain
# non-reasoning model if you want a tighter latency bound.
CAII_MAX_OUTPUT_TOKENS=1024

# Only needed if STT_PROVIDER=cloudera_whisper -- a Whisper/Riva model served
# on Cloudera AI Inference Service (separate deployment from the LLM above).
# Example base URL shape:
#   https://<domain>/namespaces/serving-default/endpoints/<whisper-endpoint>/v1
CAII_STT_BASE_URL=
CAII_STT_API_KEY=
CAII_STT_MODEL_NAME=nvidia/riva-asr/whisper

CUSTOMER_DB_PATH=app/data/customers.db
MAX_HISTORY_TURNS=6
